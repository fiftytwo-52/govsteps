---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Optional OG image absolute or relative URL */
  ogImage?: string;
  /** Optional JSON-LD objects to embed on this page (HowTo, FAQPage, etc.) */
  schema?: Record<string, unknown>[];
  /** Override the robots meta directive (default: index, follow) */
  robots?: string;
}

const {
  title,
  description = 'Step-by-step guides for US, UK, and Canadian government paperwork — taxes, immigration, IDs, and benefits explained in plain language.',
  ogImage,
  schema = [],
  robots = 'index, follow',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'GovSteps';
const formattedTitle = title.includes('GovSteps') ? title : `${title} - GovSteps`;
const resolvedOgImage = ogImage
  ? (ogImage.startsWith('http') ? new URL(ogImage) : new URL(ogImage, Astro.site))
  : new URL('/images/og/og-itin-guide.png', Astro.site);

const currentPath = Astro.url.pathname;
const isUk = currentPath.startsWith('/uk');
const isCan = currentPath.startsWith('/can');
const activeCountry = isUk ? 'uk' : isCan ? 'ca' : 'us';

// Site-level structured data (merged with any page-level schema).
const siteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: Astro.site?.toString() ?? canonicalURL.origin,
    description,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: siteName,
    url: Astro.site?.toString() ?? canonicalURL.origin,
    logo: new URL('/images/logos/logo.svg', Astro.site).toString(),
    description: 'Plain-language, step-by-step guides for US, UK, and Canadian government paperwork.',
  },
];
const allSchema = [...siteSchema, ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png" />
    {!robots?.includes('noindex') && <link rel="canonical" href={canonicalURL} />}
    <title>{formattedTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={formattedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={formattedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Structured data -->
    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline>
      // Restore theme before paint to avoid flash
      const theme = localStorage.getItem('theme') ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>

    <!-- Google AdSense -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6972199969440681" crossorigin="anonymous"></script>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XG1X8DE2Y8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-XG1X8DE2Y8');
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <!-- nav-bar: canvas background, hairline bottom border -->
    <header class="sticky top-0 z-50 border-b border-hairline bg-canvas/80 backdrop-blur dark:border-hairline-dark dark:bg-canvas-dark/80">
      <div class="container-geist flex items-center justify-between py-2.5">
        <!-- Logo: DocuCheck mark + wordmark -->
        <a href="/" class="flex items-center gap-2.5 focus:outline-none focus-visible:ring-1 focus-visible:ring-link" aria-label="GovSteps homepage">
          <svg class="h-8 w-auto" viewBox="0 0 256 72" role="img" aria-hidden="true">
            <rect x="10" y="8" width="40" height="56" rx="6" fill="#FFFFFF" stroke="#14263F" class="dark:stroke-white/80" stroke-width="5"/>
            <path d="M36 8 H50 V22 Z" fill="#F5A623"/>
            <line x1="19" y1="33" x2="41" y2="33" stroke="#14263F" stroke-width="4" stroke-linecap="round"/>
            <line x1="19" y1="41" x2="41" y2="41" stroke="#14263F" stroke-width="4" stroke-linecap="round"/>
            <line x1="19" y1="49" x2="33" y2="49" stroke="#14263F" stroke-width="4" stroke-linecap="round"/>
            <circle cx="50" cy="54" r="15" fill="#F5A623" stroke="#FFFFFF" stroke-width="3"/>
            <path d="M43 54 l5 5 l10 -11" fill="none" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            <text x="76" y="49" font-family="system-ui, -apple-system, sans-serif" font-size="33" font-weight="700" letter-spacing="-0.5">
              <tspan class="fill-[#14263F] dark:fill-white">Gov</tspan><tspan fill="#F5A623">Steps</tspan>
            </text>
          </svg>
        </a>

        <!-- Country Switcher (header, on every page: United States · United Kingdom · Canada) -->
        <div class="hidden items-center rounded-full border border-hairline bg-canvas-elevated p-0.5 text-xs font-medium md:flex dark:border-hairline-dark dark:bg-canvas-elevated-dark" role="navigation" aria-label="Country switcher">
          <a
            href="/"
            class={`rounded-full px-3 py-1 transition-colors ${activeCountry === 'us' ? 'bg-ink text-canvas font-semibold dark:bg-ink-dark dark:text-canvas-dark' : 'text-body hover:text-ink dark:text-body-dark dark:hover:text-ink-dark'}`}
            aria-current={activeCountry === 'us' ? 'page' : undefined}
          >
            United States
          </a>
          <a
            href="/uk/"
            class={`rounded-full px-3 py-1 transition-colors ${activeCountry === 'uk' ? 'bg-ink text-canvas font-semibold dark:bg-ink-dark dark:text-canvas-dark' : 'text-body hover:text-ink dark:text-body-dark dark:hover:text-ink-dark'}`}
            aria-current={activeCountry === 'uk' ? 'page' : undefined}
          >
            United Kingdom
          </a>
          <a
            href="/can/"
            class={`rounded-full px-3 py-1 transition-colors ${activeCountry === 'ca' ? 'bg-ink text-canvas font-semibold dark:bg-ink-dark dark:text-canvas-dark' : 'text-body hover:text-ink dark:text-body-dark dark:hover:text-ink-dark'}`}
            aria-current={activeCountry === 'ca' ? 'page' : undefined}
          >
            Canada
          </a>
        </div>

        <!-- Nav + controls: top-right -->
        <div class="flex items-center gap-2">
          <nav class="hidden items-center gap-1 text-sm font-medium lg:flex">
            <a href="/about/" class="rounded-full px-3 py-1.5 text-body hover:text-ink dark:text-body-dark dark:hover:text-ink-dark">About</a>
            <a href="/contact/" class="rounded-full px-3 py-1.5 text-body hover:text-ink dark:text-body-dark dark:hover:text-ink-dark">Contact</a>
          </nav>

          <button id="theme-toggle" aria-label="Toggle dark mode" class="grid size-8 place-items-center rounded-sm border border-hairline bg-canvas-elevated text-ink hover:bg-hairline-soft dark:border-hairline-dark dark:bg-canvas-elevated-dark dark:text-ink-dark dark:hover:bg-hairline-soft-dark">
            <svg class="size-4 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
            <svg class="hidden size-4 dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          </button>
          <button id="menu-toggle" aria-label="Open menu" aria-expanded="false" class="grid size-8 place-items-center rounded-sm border border-hairline bg-canvas-elevated text-ink hover:bg-hairline-soft md:hidden dark:border-hairline-dark dark:bg-canvas-elevated-dark dark:text-ink-dark dark:hover:bg-hairline-soft-dark">
            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <nav id="mobile-menu" class="hidden border-t border-hairline md:hidden dark:border-hairline-dark">
        <div class="container-geist py-3">
          <p class="font-mono text-[10px] font-semibold uppercase tracking-wider text-mute dark:text-mute-dark">Country Hubs</p>
          <div class="mt-2 flex flex-col gap-1 text-sm font-medium">
            <a href="/" class={`rounded-md px-3 py-2 ${activeCountry === 'us' ? 'bg-ink text-canvas dark:bg-ink-dark dark:text-canvas-dark' : 'text-body hover:bg-hairline-soft hover:text-ink dark:text-body-dark dark:hover:bg-hairline-soft-dark dark:hover:text-ink-dark'}`}>United States Guides</a>
            <a href="/uk/" class={`rounded-md px-3 py-2 ${activeCountry === 'uk' ? 'bg-ink text-canvas dark:bg-ink-dark dark:text-canvas-dark' : 'text-body hover:bg-hairline-soft hover:text-ink dark:text-body-dark dark:hover:bg-hairline-soft-dark dark:hover:text-ink-dark'}`}>United Kingdom Guides</a>
            <a href="/can/" class={`rounded-md px-3 py-2 ${activeCountry === 'ca' ? 'bg-ink text-canvas dark:bg-ink-dark dark:text-canvas-dark' : 'text-body hover:bg-hairline-soft hover:text-ink dark:text-body-dark dark:hover:bg-hairline-soft-dark dark:hover:text-ink-dark'}`}>Canada Guides</a>
          </div>
          <div class="mt-3 border-t border-hairline pt-3 dark:border-hairline-dark">
            <div class="flex flex-col gap-1 text-sm font-medium">
              <a href="/about/" class="rounded-md px-3 py-2 text-body hover:bg-hairline-soft hover:text-ink dark:text-body-dark dark:hover:bg-hairline-soft-dark dark:hover:text-ink-dark">About</a>
              <a href="/contact/" class="rounded-md px-3 py-2 text-body hover:bg-hairline-soft hover:text-ink dark:text-body-dark dark:hover:bg-hairline-soft-dark dark:hover:text-ink-dark">Contact</a>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main class="flex w-full flex-1 flex-col">
      <slot />
    </main>

    <!-- footer: canvas, hairline top border, body-grey text -->
    <footer class="border-t border-hairline bg-canvas dark:border-hairline-dark dark:bg-canvas-dark">
      <div class="container-geist py-16">
        <div class="grid gap-10 sm:grid-cols-3">
          <div>
            <a href="/" class="flex items-center gap-2 focus:outline-none focus-visible:ring-1 focus-visible:ring-link" aria-label="GovSteps home">
              <svg class="h-7 w-auto" viewBox="0 0 256 72" role="img" aria-hidden="true">
                <rect x="10" y="8" width="40" height="56" rx="6" fill="#FFFFFF" stroke="#14263F" class="dark:stroke-white/80" stroke-width="5"/>
                <path d="M36 8 H50 V22 Z" fill="#F5A623"/>
                <line x1="19" y1="33" x2="41" y2="33" stroke="#14263F" stroke-width="4" stroke-linecap="round"/>
                <line x1="19" y1="41" x2="41" y2="41" stroke="#14263F" stroke-width="4" stroke-linecap="round"/>
                <line x1="19" y1="49" x2="33" y2="49" stroke="#14263F" stroke-width="4" stroke-linecap="round"/>
                <circle cx="50" cy="54" r="15" fill="#F5A623" stroke="#FFFFFF" stroke-width="3"/>
                <path d="M43 54 l5 5 l10 -11" fill="none" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                <text x="76" y="49" font-family="system-ui, -apple-system, sans-serif" font-size="33" font-weight="700" letter-spacing="-0.5">
                  <tspan class="fill-[#14263F] dark:fill-white">Gov</tspan><tspan fill="#F5A623">Steps</tspan>
                </text>
              </svg>
            </a>
            <p class="mt-2 max-w-xs text-sm text-body dark:text-body-dark">Plain-language, step-by-step guides for US, UK, and Canadian government paperwork.</p>
          </div>
          <div class="text-sm">
            <p class="eyebrow">Countries</p>
            <ul class="mt-3 space-y-2 text-body dark:text-body-dark">
              <li><a href="/" class="hover:text-ink dark:hover:text-ink-dark">United States</a></li>
              <li><a href="/uk/" class="hover:text-ink dark:hover:text-ink-dark">United Kingdom</a></li>
              <li><a href="/can/" class="hover:text-ink dark:hover:text-ink-dark">Canada</a></li>
            </ul>
          </div>
          <div class="text-sm">
            <p class="eyebrow">Site</p>
            <ul class="mt-3 space-y-2 text-body dark:text-body-dark">
              <li><a href="/#guides" class="hover:text-ink dark:hover:text-ink-dark">All Guides</a></li>
              <li><a href="/about/" class="hover:text-ink dark:hover:text-ink-dark">About</a></li>
              <li><a href="/contact/" class="hover:text-ink dark:hover:text-ink-dark">Contact</a></li>
            </ul>
          </div>
          <div class="text-sm">
            <p class="eyebrow">Legal</p>
            <ul class="mt-3 space-y-2 text-body dark:text-body-dark">
              <li><a href="/privacy/" class="hover:text-ink dark:hover:text-ink-dark">Privacy Policy</a></li>
              <li><a href="/terms/" class="hover:text-ink dark:hover:text-ink-dark">Terms of Use</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-12 border-t border-hairline pt-6 text-xs text-mute dark:border-hairline-dark dark:text-mute-dark">
          <p>GovSteps is an independent informational website. It is not affiliated with any US, UK, or Canadian government agency. Always verify requirements at official sources (<a href="https://www.usa.gov" target="_blank" rel="noopener noreferrer" class="underline hover:text-ink dark:hover:text-ink-dark">usa.gov</a>, <a href="https://www.gov.uk" target="_blank" rel="noopener noreferrer" class="underline hover:text-ink dark:hover:text-ink-dark">gov.uk</a>, <a href="https://www.canada.ca" target="_blank" rel="noopener noreferrer" class="underline hover:text-ink dark:hover:text-ink-dark">canada.ca</a>, and their agencies).</p>
          <p class="mt-2">&copy; {new Date().getFullYear()} GovSteps. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script>
      // Dark mode toggle
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
      // Mobile menu toggle
      const menuBtn = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      menuBtn?.addEventListener('click', () => {
        const open = menu?.classList.toggle('hidden') === false;
        menuBtn.setAttribute('aria-expanded', String(open));
      });

      // Glossary term tooltips: the tip element is portaled to <body> on first
      // hover so it is never affected by transformed/clipped ancestors, then
      // positioned in viewport coordinates right where the pointer is.
      let activeTerm: HTMLElement | null = null;
      let activeTip: HTMLElement | null = null;
      let pointerX = 0;
      let pointerY = 0;

      function placeTip(x: number, y: number) {
        if (!activeTip) return;
        const pad = 8;
        const vw = window.innerWidth;
        const vh = window.innerHeight;
        const w = activeTip.offsetWidth;
        const h = activeTip.offsetHeight;
        // Default: centered under the pointer, offset below it.
        let left = x - w / 2;
        let top = y + 18;
        // Flip above the pointer if it would overflow the bottom.
        if (top + h > vh - pad) top = y - h - 12;
        // Clamp inside the viewport horizontally.
        if (left < pad) left = pad;
        if (left + w > vw - pad) left = vw - w - pad;
        if (top < pad) top = pad;
        activeTip.style.left = `${Math.round(left)}px`;
        activeTip.style.top = `${Math.round(top)}px`;
      }

      function activate(term: HTMLElement) {
        const tip = term.querySelector(':scope > [role="tooltip"]');
        if (!(tip instanceof HTMLElement)) return;
        // Portal the tip to <body> — escaping any transformed,
        // overflow-clipped, or stacking-context ancestor so position:fixed
        // truly means viewport-relative. Visibility is controlled here via
        // inline opacity: the group-hover/term CSS classes cannot apply once
        // the tip is portaled out of the term.
        if (activeTip && activeTip !== tip && activeTip.parentElement === document.body) {
          activeTip.style.opacity = '0';
          activeTerm?.appendChild(activeTip);
        }
        if (tip.parentElement !== document.body) document.body.appendChild(tip);
        tip.style.opacity = '1';
        activeTerm = term;
        activeTip = tip;
      }

      // Return the tip into its term (so it can be found again on the next
      // hover) and hide it.
      function deactivate() {
        if (activeTip && activeTerm && activeTip.parentElement === document.body) {
          activeTip.style.opacity = '0';
          activeTerm.appendChild(activeTip);
        }
        activeTip = null;
        activeTerm = null;
      }

      document.addEventListener('mouseover', (e) => {
        const term = (e.target as HTMLElement).closest<HTMLElement>('[data-term]');
        if (term) {
          activate(term);
          pointerX = e.clientX;
          pointerY = e.clientY;
          placeTip(pointerX, pointerY);
        }
      });
      // Follow the mouse while it moves across the term.
      document.addEventListener('mousemove', (e) => {
        if (!activeTip || !(e.target as HTMLElement).closest?.('[data-term]')) return;
        pointerX = e.clientX;
        pointerY = e.clientY;
        placeTip(pointerX, pointerY);
      });
      // Keyboard focus: anchor to the focused term (no pointer yet).
      document.addEventListener('focusin', (e) => {
        const term = (e.target as HTMLElement).closest<HTMLElement>('[data-term]');
        if (term) {
          activate(term);
          const r = term.getBoundingClientRect();
          placeTip(r.left + r.width / 2, r.bottom);
        }
      });
      // When a term is left, hide the tip and return it to its term so the
      // next hover can find it again.
      document.addEventListener('mouseout', (e) => {
        const term = (e.target as HTMLElement).closest<HTMLElement>('[data-term]');
        if (term && !term.contains(e.relatedTarget as Node) && activeTip?.parentElement === document.body) {
          deactivate();
        }
      });
      // While the tip lives on <body> it never scrolls with the term —
      // hide it on scroll so it does not hover over unrelated content.
      window.addEventListener(
        'scroll',
        () => {
          if (activeTip?.parentElement === document.body) {
            deactivate();
          }
        },
        { passive: true, capture: true },
      );
    </script>
  </body>
</html>
