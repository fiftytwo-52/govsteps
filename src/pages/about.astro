---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { guides, totalSteps } from '../data/guides';
---

<Layout
  title="About — GovSteps"
  description="GovSteps writes plain-language, step-by-step guides for US, UK, and Canadian government paperwork — taxes, immigration, IDs, and benefits."
>
  <!-- Hero band -->
  <section class="relative overflow-hidden border-b border-hairline dark:border-hairline-dark">
    <div class="huge-bg-word" aria-hidden="true"><span>PAPERWORK</span></div>
    <div class="container-geist relative z-10 grid items-center gap-8 py-8 lg:grid-cols-2 lg:gap-12 lg:py-12">
      <div class="max-w-3xl">
        <p class="eyebrow">About GovSteps</p>
        <h1 class="heading-lg mt-2 text-ink dark:text-ink-dark">Paperwork, in the order you actually live it.</h1>
        <p class="mt-5 text-base leading-relaxed text-body dark:text-body-dark">
          Government processes are confusing by design: scattered forms, vague instructions, and official websites that assume
          you already know what a "Form I-797" or "P45" is. GovSteps exists to fix that — {guides.length} guides and {totalSteps} steps
          across the US, UK, and Canada, written in clear, plain language.
        </p>
        <div class="mt-6 flex flex-wrap gap-4 text-xs font-mono text-mute dark:text-mute-dark">
          <span>{guides.length} Verified Guides</span>
          <span>&bull;</span>
          <span>3 Countries Covered</span>
          <span>&bull;</span>
          <span>Zero User Fees</span>
        </div>
      </div>
      <div class="overflow-hidden rounded-lg border border-hairline bg-canvas-elevated shadow-sm dark:border-hairline-dark dark:bg-canvas-elevated-dark">
        <picture>
          <source srcset="/images/lifestyle/lifestyle-office-clerk-help.webp" type="image/webp" />
          <img
            src="/images/lifestyle/lifestyle-office-clerk-help.png"
            alt="Government clerk helping a citizen at a service counter"
            width="1920"
            height="1280"
            class="h-auto w-full object-cover"
            loading="eager"
            decoding="async"
          />
        </picture>
      </div>
    </div>
  </section>

  <!-- Editorial standards & review schedule (TASK-10 / TASK-11) -->
  <section id="standards" class="border-b border-hairline dark:border-hairline-dark">
    <div class="container-geist grid gap-8 py-8 lg:grid-cols-2 lg:gap-12 lg:py-12">
      <div>
        <p class="eyebrow">Integrity & Fact-Checking</p>
        <h2 class="heading-lg mt-2 text-ink dark:text-ink-dark">Our rigorous review lifecycle</h2>
        <p class="mt-5 text-base leading-relaxed text-body dark:text-body-dark">
          Government agencies regularly change form editions, filing fees, procedural requirements, and mailing addresses. To ensure you never submit outdated paperwork, we enforce a strict review cycle:
        </p>
        <div class="mt-6 space-y-4">
          <div class="rounded-lg border border-hairline bg-canvas-elevated p-4 dark:border-hairline-dark dark:bg-canvas-elevated-dark">
            <h3 class="text-sm font-semibold text-ink dark:text-ink-dark flex items-center gap-2">
              <span class="size-2 rounded-full bg-amber-500"></span>
              6-Month Mandatory Review (Volatile Domains)
            </h3>
            <p class="mt-1.5 text-xs leading-relaxed text-body dark:text-body-dark">
              Guides under <strong>Taxes</strong>, <strong>Immigration</strong>, and <strong>Healthcare / Benefits</strong> undergo a complete source-reverification every six months. If a guide exceeds this window, an automated review alert is published directly on the guide.
            </p>
          </div>
          <div class="rounded-lg border border-hairline bg-canvas-elevated p-4 dark:border-hairline-dark dark:bg-canvas-elevated-dark">
            <h3 class="text-sm font-semibold text-ink dark:text-ink-dark flex items-center gap-2">
              <span class="size-2 rounded-full bg-emerald-500"></span>
              Annual Verification (Stable Domains)
            </h3>
            <p class="mt-1.5 text-xs leading-relaxed text-body dark:text-body-dark">
              Guides under <strong>IDs & Passports</strong>, <strong>Civil Records</strong>, and <strong>Business Filings</strong> are checked annually against statutory rules and updated ministry guidelines.
            </p>
          </div>
        </div>
      </div>

      <div class="flex flex-col justify-between rounded-lg border border-hairline bg-hairline-soft/50 p-6 dark:border-hairline-dark dark:bg-hairline-soft-dark/30 sm:p-8">
        <div>
          <h3 class="text-lg font-semibold text-ink dark:text-ink-dark">Primary Source Protocol</h3>
          <p class="mt-2 text-sm leading-relaxed text-body dark:text-body-dark">
            GovSteps researchers cross-reference every statutory claim, timeline, and document requirement against authoritative government domains only:
          </p>
          <ul class="mt-4 space-y-2.5 text-xs text-body dark:text-body-dark font-mono">
            <li class="flex items-center gap-2"><Icon name="check" class="size-3.5 text-link" /> United States: irs.gov, uscis.gov, travel.state.gov, ssa.gov</li>
            <li class="flex items-center gap-2"><Icon name="check" class="size-3.5 text-link" /> United Kingdom: gov.uk, hmrc.gov.uk, homeoffice.gov.uk</li>
            <li class="flex items-center gap-2"><Icon name="check" class="size-3.5 text-link" /> Canada: canada.ca, cra-arc.gc.ca, cic.gc.ca</li>
          </ul>
        </div>

        <div id="corrections" class="mt-8 rounded-lg border border-hairline bg-canvas-elevated p-5 dark:border-hairline-dark dark:bg-canvas-elevated-dark">
          <h4 class="text-sm font-semibold text-ink dark:text-ink-dark flex items-center gap-2">
            <Icon name="alert" class="size-4 text-link" />
            Corrections & Updates Policy
          </h4>
          <p class="mt-2 text-xs leading-relaxed text-body dark:text-body-dark">
            If an agency updates a filing fee or form number before our scheduled review, we prioritize verified community corrections. Reports are investigated and live guides updated within 48 hours.
          </p>
          <a
            href="mailto:gun-yes@proton.me?subject=Correction%20Report%20%E2%80%94%20GovSteps"
            class="mt-3 inline-flex items-center gap-1.5 text-xs font-medium text-link hover:underline dark:text-link-dark"
          >
            Submit an editorial correction &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- The format: grey panel band -->
  <section class="border-b border-hairline bg-hairline-soft/60 dark:border-hairline-dark dark:bg-hairline-soft-dark/40">
    <div class="container-geist py-8 sm:py-10 lg:py-12">
      <div class="max-w-2xl">
        <p class="eyebrow">The Format</p>
        <h2 class="heading-lg mt-2 text-ink dark:text-ink-dark">One format, every guide</h2>
        <p class="mt-3 text-base text-body dark:text-body-dark">
          Every guide on this site follows the same ground-level structure — no jargon, no assumptions, just the steps in order.
        </p>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { icon: 'clipboard', title: 'Documents', text: 'Exactly what to gather before you start — and how to get each one.' },
          { icon: 'pin', title: 'Offices', text: 'Which office or portal to visit, and what to bring when you do.' },
          { icon: 'pen', title: 'Forms', text: 'Which form to ask for and what to watch for while filling it.' },
          { icon: 'hourglass', title: 'Waits & costs', text: 'How long each stage takes, what it costs, and how to follow up.' },
        ].map((item) => (
          <div class="rounded-md border border-hairline bg-canvas-elevated p-6 dark:border-hairline-dark dark:bg-canvas-elevated-dark">
            <span class="grid size-10 place-items-center rounded-md border border-hairline bg-canvas text-ink dark:border-hairline-dark dark:bg-canvas-dark dark:text-ink-dark">
              <Icon name={item.icon} class="size-5" />
            </span>
            <h3 class="mt-4 text-base font-semibold text-ink dark:text-ink-dark">{item.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-body dark:text-body-dark">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Editorial promise: canvas band, two columns -->
  <section class="border-b border-hairline dark:border-hairline-dark">
    <div class="container-geist grid gap-8 py-8 lg:grid-cols-2 lg:gap-12 lg:py-12">
      <div>
        <p class="eyebrow">Our Promise</p>
        <h2 class="heading-lg mt-2 text-ink dark:text-ink-dark">The editorial promise</h2>
        <p class="mt-5 text-base leading-relaxed text-body dark:text-body-dark">
          We cover the topics that matter most to people navigating US, UK, and Canadian systems: taxes, immigration, passports
          and IDs, driver's licences, health coverage, benefits, and starting a business. Our guides are written for citizens,
          immigrants, and expats alike — because paperwork does not care who you are. Immigration guides even include
          translation guidance for Hindi, Nepali, Portuguese (Brazil), and Spanish speakers.
        </p>
      </div>
      <div class="rounded-md border border-hairline bg-canvas-elevated p-6 dark:border-hairline-dark dark:bg-canvas-elevated-dark sm:p-8">
        <ul class="space-y-4 text-sm leading-relaxed text-body dark:text-body-dark">
          <li class="flex gap-3"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-link dark:text-link-dark" /> Every guide names the official source you should verify against (irs.gov, uscis.gov, gov.uk, canada.ca, and their agencies).</li>
          <li class="flex gap-3"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-link dark:text-link-dark" /> Fees, timelines, and form numbers are flagged as changeable — always confirm before you act.</li>
          <li class="flex gap-3"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-link dark:text-link-dark" /> We never charge users for information. Access to every guide is free.</li>
          <li class="flex gap-3"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-link dark:text-link-dark" /> We are an independent website — not affiliated with, endorsed by, or connected to any US, UK, or Canadian government agency.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Process band -->
  <section class="py-8 sm:py-10 lg:py-12">
    <div class="container-geist">
      <div class="max-w-2xl">
        <p class="eyebrow">Process</p>
        <h2 class="heading-lg mt-2 text-ink dark:text-ink-dark">How these guides are made</h2>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { num: '01', icon: 'search', title: 'Researched at the source', text: 'Guides are researched from official government sources — the agency that actually runs the process — with a data-freshness label showing when we last checked.' },
          { num: '02', icon: 'pen', title: 'Written in plain language', text: 'Every step is rewritten until it reads like a friend explaining it, not a form instruction.' },
          { num: '03', icon: 'alert', title: 'Flagged where facts drift', text: 'Where facts change often (fees, processing times, income limits), we mark them and point to the source.' },
        ].map((step) => (
          <div class="rounded-md border border-hairline bg-canvas-elevated p-6 dark:border-hairline-dark dark:bg-canvas-elevated-dark">
            <div class="flex items-center justify-between">
              <span class="grid size-9 place-items-center rounded-md border border-hairline bg-canvas text-ink dark:border-hairline-dark dark:bg-canvas-dark dark:text-ink-dark">
                <Icon name={step.icon} class="size-4" />
              </span>
              <p class="font-mono text-xs font-medium text-mute dark:text-mute-dark">{step.num}</p>
            </div>
            <h3 class="mt-4 text-base font-semibold text-ink dark:text-ink-dark">{step.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-body dark:text-body-dark">{step.text}</p>
          </div>
        ))}
      </div>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-body dark:text-body-dark">
        Found an error or an outdated detail? Please <a href="/contact/" class="font-medium text-link hover:underline dark:text-link-dark">tell us</a> —
        corrections keep these guides trustworthy for everyone.
      </p>
    </div>
  </section>
</Layout>
