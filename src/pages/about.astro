---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import AboutHeroArt from '../components/AboutHeroArt.astro';
import { guides, totalSteps } from '../data/guides';
---

<Layout title="About — GovSteps" description="GovSteps writes plain-language, step-by-step guides for US, UK, and Canadian government paperwork — taxes, immigration, IDs, and benefits.">
  <!-- Hero band -->
  <section class="relative overflow-hidden border-b border-hairline dark:border-hairline-dark">
    <div class="huge-bg-word" aria-hidden="true"><span>PAPERWORK</span></div>
    <div class="container-geist relative z-10 grid items-center gap-12 py-24 lg:grid-cols-2 lg:gap-16">
      <div class="max-w-3xl">
        <p class="eyebrow">About</p>
        <h1 class="heading-lg mt-2 text-ink dark:text-ink-dark">Paperwork, in the order you actually live it.</h1>
        <p class="mt-5 text-base leading-relaxed text-body dark:text-body-dark">
          Government processes are confusing by design: scattered forms, vague instructions, and official websites that assume
          you already know what a "Form I-797" is. GovSteps exists to fix that — {guides.length} guides and {totalSteps} steps
          across the US, UK, and Canada, written in plain language.
        </p>
      </div>
      <AboutHeroArt class="hidden w-full max-w-md justify-self-center lg:block" />
    </div>
  </section>

  <!-- The format: grey panel band -->
  <section class="border-b border-hairline bg-hairline-soft/60 dark:border-hairline-dark dark:bg-hairline-soft-dark/40">
    <div class="container-geist py-24">
      <div class="max-w-2xl">
        <p class="eyebrow">The Format</p>
        <h2 class="heading-lg mt-2 text-ink dark:text-ink-dark">One format, every guide</h2>
        <p class="mt-3 text-base text-body dark:text-body-dark">
          Every guide on this site follows the same ground-level structure — no jargon, no assumptions, just the steps in order.
        </p>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { icon: 'clipboard', title: 'Documents', text: 'Exactly what to gather before you start — and how to get each one.' },
          { icon: 'pin', title: 'Offices', text: 'Which office or portal to visit, and what to bring when you do.' },
          { icon: 'pen', title: 'Forms', text: 'Which form to ask for and what to watch for while filling it.' },
          { icon: 'hourglass', title: 'Waits & costs', text: 'How long each stage takes, what it costs, and how to follow up.' },
        ].map((item) => (
          <div class="rounded-md border border-hairline bg-canvas-elevated p-6 dark:border-hairline-dark dark:bg-canvas-elevated-dark">
            <span class="grid size-10 place-items-center rounded-md border border-hairline bg-canvas text-ink dark:border-hairline-dark dark:bg-canvas-dark dark:text-ink-dark">
              <Icon name={item.icon} class="size-5" />
            </span>
            <h3 class="mt-4 text-base font-semibold text-ink dark:text-ink-dark">{item.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-body dark:text-body-dark">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Editorial promise: canvas band, two columns -->
  <section class="border-b border-hairline dark:border-hairline-dark">
    <div class="container-geist grid gap-12 py-24 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="eyebrow">Our Promise</p>
        <h2 class="heading-lg mt-2 text-ink dark:text-ink-dark">The editorial promise</h2>
        <p class="mt-5 text-base leading-relaxed text-body dark:text-body-dark">
          We cover the topics that matter most to people navigating US, UK, and Canadian systems: taxes, immigration, passports
          and IDs, driver's licences, health coverage, benefits, and starting a business. Our guides are written for citizens,
          immigrants, and expats alike — because paperwork does not care who you are. Immigration guides even include
          translation guidance for Hindi, Nepali, Portuguese (Brazil), and Spanish speakers.
        </p>
      </div>
      <div class="rounded-md border border-hairline bg-canvas-elevated p-6 dark:border-hairline-dark dark:bg-canvas-elevated-dark sm:p-8">
        <ul class="space-y-4 text-sm leading-relaxed text-body dark:text-body-dark">
          <li class="flex gap-3"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-link dark:text-link-dark" /> Every guide names the official source you should verify against (irs.gov, uscis.gov, gov.uk, canada.ca, and their agencies).</li>
          <li class="flex gap-3"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-link dark:text-link-dark" /> Fees, timelines, and form numbers are flagged as changeable — always confirm before you act.</li>
          <li class="flex gap-3"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-link dark:text-link-dark" /> We never charge users for information. Access to every guide is free.</li>
          <li class="flex gap-3"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-link dark:text-link-dark" /> We are an independent website — not affiliated with, endorsed by, or connected to any US, UK, or Canadian government agency.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Process band -->
  <section class="py-24">
    <div class="container-geist">
      <div class="max-w-2xl">
        <p class="eyebrow">Process</p>
        <h2 class="heading-lg mt-2 text-ink dark:text-ink-dark">How these guides are made</h2>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { num: '01', icon: 'search', title: 'Researched at the source', text: 'Guides are researched from official government sources — the agency that actually runs the process — with a data-freshness label showing when we last checked.' },
          { num: '02', icon: 'pen', title: 'Written in plain language', text: 'Every step is rewritten until it reads like a friend explaining it, not a form instruction.' },
          { num: '03', icon: 'alert', title: 'Flagged where facts drift', text: 'Where facts change often (fees, processing times, income limits), we mark them and point to the source.' },
        ].map((step) => (
          <div class="rounded-md border border-hairline bg-canvas-elevated p-6 dark:border-hairline-dark dark:bg-canvas-elevated-dark">
            <div class="flex items-center justify-between">
              <span class="grid size-9 place-items-center rounded-md border border-hairline bg-canvas text-ink dark:border-hairline-dark dark:bg-canvas-dark dark:text-ink-dark">
                <Icon name={step.icon} class="size-4" />
              </span>
              <p class="font-mono text-xs font-medium text-mute dark:text-mute-dark">{step.num}</p>
            </div>
            <h3 class="mt-4 text-base font-semibold text-ink dark:text-ink-dark">{step.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-body dark:text-body-dark">{step.text}</p>
          </div>
        ))}
      </div>
      <p class="mt-10 max-w-2xl text-base leading-relaxed text-body dark:text-body-dark">
        Found an error or an outdated detail? Please <a href="/contact/" class="font-medium text-link hover:underline dark:text-link-dark">tell us</a> —
        corrections keep these guides trustworthy for everyone.
      </p>
    </div>
  </section>
</Layout>
