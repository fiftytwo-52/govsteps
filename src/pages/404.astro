---
import Layout from '../layouts/Layout.astro';
import NotFoundArt from '../components/NotFoundArt.astro';
import { guides, guidePath } from '../data/guides';

const randomGuides = [...guides].sort(() => 0.5 - Math.random()).slice(0, 3);
---

<Layout title="Page Not Found — GovSteps">
  <section class="relative overflow-hidden py-24 text-center">
    <div class="huge-bg-word" aria-hidden="true"><span>404</span></div>
    <div class="container-geist relative z-10">
    <NotFoundArt class="mx-auto w-full max-w-sm" />
    <p class="mt-6 font-mono text-sm font-medium text-mute dark:text-mute-dark">404</p>
    <h1 class="heading-lg mt-3 text-ink dark:text-ink-dark">This page took a wrong turn at the courthouse.</h1>
    <p class="mx-auto mt-3 max-w-md text-body dark:text-body-dark">The page you are looking for does not exist or was moved. Try one of these guides instead:</p>

    <div class="mx-auto mt-8 grid max-w-3xl gap-3 sm:grid-cols-3">
      {randomGuides.map((g) => (
        <a href={`${guidePath(g)}/`} class="rounded-md border border-hairline bg-canvas-elevated p-4 text-sm font-medium text-ink transition-all hover:-translate-y-0.5 hover:border-link hover:text-link dark:border-hairline-dark dark:bg-canvas-elevated-dark dark:text-ink-dark dark:hover:border-link-dark dark:hover:text-link-dark">
          {g.title}
        </a>
      ))}
    </div>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-ink px-6 py-2.5 text-base font-medium leading-5 text-canvas hover:opacity-80 dark:bg-ink-dark dark:text-canvas-dark">Go to Homepage</a>
      <a href="/#guides" class="rounded-full border border-hairline bg-canvas-elevated px-6 py-2.5 text-base font-medium leading-5 text-ink hover:bg-hairline-soft dark:border-hairline-dark dark:bg-canvas-elevated-dark dark:text-ink-dark dark:hover:bg-hairline-soft-dark">Browse All Guides</a>
    </div>
    </div>
  </section>
</Layout>
