---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import CountryFlag from './CountryFlag.astro';
import CardArt from './CardArt.astro';
import Faq from './Faq.astro';
import { guides, categories, guidePath, getCountry } from '../data/guides';
import type { CountryCode } from '../data/guides';
import { topicData } from '../data/topicContent';

interface Props {
  country: CountryCode;
  topic: string;
}

const { country: countryCode, topic } = Astro.props;
const country = getCountry(countryCode);
const category = categories.find((c) => c.id === topic);

if (!category) {
  throw new Error(`Category "${topic}" not found`);
}

const editorial = topicData[countryCode]?.[topic] ?? {
  headline: `${country.name} ${category.name} Guides: Requirements & Process`,
  lead: `Step-by-step government paperwork guides for ${category.name.toLowerCase()} in ${country.name}.`,
  body: `Learn how to navigate ${category.name.toLowerCase()} paperwork in ${country.name}. Each guide includes document checklists, official agency links, fees, and sequential step-by-step instructions.`,
  agencyOverview: `Official agencies: ${country.sources}`,
  faqs: [],
};

const topicGuides = guides.filter((g) => g.country === countryCode && g.category === topic);
const homeHref = country.pathPrefix ? `${country.pathPrefix}/` : '/';
const topicUrl = new URL(
  country.pathPrefix ? `${country.pathPrefix}/topics/${topic}/` : `/topics/${topic}/`,
  Astro.site
).toString();

const pageTitle = `${category.name} Guides (${country.short}) - Step-by-Step Government Paperwork`;
const pageDescription = `${editorial.lead.slice(0, 155)}`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://govsteps.com/' },
    { '@type': 'ListItem', position: 2, name: country.name, item: new URL(homeHref, Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: `${category.name} Guides`, item: topicUrl },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: topicUrl,
  inLanguage: 'en',
  hasPart: topicGuides.map((g) => ({
    '@type': 'HowTo',
    name: g.title,
    description: g.description,
    url: new URL(guidePath(g), Astro.site).toString(),
  })),
};

const faqSchema = editorial.faqs && editorial.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: editorial.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : undefined;

const schemas = [breadcrumbSchema, collectionSchema, ...(faqSchema ? [faqSchema] : [])];
---

<Layout title={pageTitle} description={pageDescription} schema={schemas}>
  <!-- Hero banner -->
  <section class="relative overflow-hidden border-b border-hairline bg-hairline-soft/60 dark:border-hairline-dark dark:bg-hairline-soft-dark/40">
    <div class="huge-bg-word" aria-hidden="true"><span>{category.name.toUpperCase()}</span></div>
    <div class="container-geist relative z-10 py-12 lg:py-16">
      <!-- Breadcrumbs -->
      <nav class="font-mono text-xs text-mute dark:text-mute-dark" aria-label="Breadcrumb">
        <a href="/" class="hover:text-link dark:hover:text-link-dark">Home</a>
        <span class="mx-1.5 text-mute/50">›</span>
        <a href={homeHref} class="hover:text-link dark:hover:text-link-dark">{country.name}</a>
        <span class="mx-1.5 text-mute/50">›</span>
        <span class="text-body dark:text-body-dark">{category.name} Guides</span>
      </nav>

      <header class="mt-6 max-w-3xl">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-canvas-elevated px-3 py-1 text-xs font-medium text-ink dark:bg-canvas-elevated-dark dark:text-ink-dark">
            <Icon name={category.icon} class="size-3.5" /> {category.name}
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-link-soft px-3 py-1 text-xs font-medium text-link-deep dark:bg-link-soft-dark dark:text-link-dark">
            <CountryFlag code={countryCode} class="h-3.5 w-5" /> {country.name}
          </span>
          <span class="rounded-full bg-hairline-soft px-3 py-1 font-mono text-xs text-body dark:bg-hairline-soft-dark dark:text-body-dark">
            {topicGuides.length} {topicGuides.length === 1 ? 'guide' : 'guides'}
          </span>
        </div>

        <h1 class="heading-lg mt-5 text-ink dark:text-ink-dark">{editorial.headline}</h1>
        <p class="mt-4 text-base font-medium leading-relaxed text-ink dark:text-ink-dark">
          {editorial.lead}
        </p>
        <p class="mt-3 text-sm leading-relaxed text-body dark:text-body-dark">
          {editorial.body}
        </p>
        <div class="mt-4 rounded-md border border-hairline bg-canvas p-3 text-xs text-mute dark:border-hairline-dark dark:bg-canvas-dark dark:text-mute-dark">
          {editorial.agencyOverview}
        </div>
      </header>
    </div>
  </section>

  <!-- Guides List -->
  <section class="py-12 lg:py-16">
    <div class="container-geist">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline pb-4 dark:border-hairline-dark">
        <h2 class="heading-md text-ink dark:text-ink-dark">All {category.name} Guides ({country.short})</h2>
        <p class="font-mono text-xs text-mute dark:text-mute-dark">{topicGuides.length} {topicGuides.length === 1 ? 'guide' : 'guides'}</p>
      </div>

      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {topicGuides.map((guide) => (
          <div
            class="group relative overflow-hidden rounded-md border border-hairline bg-canvas-elevated p-5 transition-all hover:-translate-y-0.5 hover:border-link hover:shadow-[0px_2px_2px_rgba(0,0,0,0.04)] dark:border-hairline-dark dark:bg-canvas-elevated-dark dark:hover:border-link-dark"
          >
            <CardArt
              category={guide.category}
              class="pointer-events-none absolute -right-4 -bottom-5 size-28 text-ink opacity-[0.06] transition-opacity duration-300 group-hover:opacity-[0.12] dark:text-ink-dark dark:opacity-[0.08] dark:group-hover:opacity-[0.16]"
            />
            <div class="relative">
              <span class="flex items-start justify-between gap-2 text-base font-semibold leading-snug text-ink group-hover:text-link dark:text-ink-dark dark:group-hover:text-link-dark">
                <a href={guidePath(guide)} class="after:absolute after:inset-0 focus:outline-none">
                  {guide.title}
                </a>
                <Icon name="arrowright" class="mt-0.5 size-4 shrink-0 -translate-x-1 text-mute opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:text-link group-hover:opacity-100 dark:text-mute-dark dark:group-hover:text-link-dark" />
              </span>
              <p class="mt-1.5 text-sm leading-relaxed text-body dark:text-body-dark">{guide.summary}</p>
              <p class="mt-3 flex flex-wrap items-center gap-x-2 font-mono text-xs text-mute dark:text-mute-dark">
                <span>{guide.steps.length} steps · {guide.totalTime} · {guide.totalCost}</span>
                {guide.updatedAt && (
                  <span class="rounded-full bg-hairline-soft px-2 py-0.5 text-[10px] font-medium text-link-deep dark:bg-hairline-soft-dark dark:text-link-dark">
                    {guide.updatedAt}-Latest
                  </span>
                )}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- FAQ Section -->
      {editorial.faqs && editorial.faqs.length > 0 && (
        <div class="mt-16 border-t border-hairline pt-12 dark:border-hairline-dark">
          <div class="max-w-3xl">
            <p class="eyebrow">FAQ</p>
            <h2 class="heading-md mt-1.5 text-ink dark:text-ink-dark">Frequently Asked Questions</h2>
            <p class="mt-2 text-sm text-body dark:text-body-dark">
              Common questions and essential rules for {category.name.toLowerCase()} in {country.name}.
            </p>
          </div>
          <div class="mt-6 max-w-3xl">
            <Faq faqs={editorial.faqs} />
          </div>
        </div>
      )}

      <!-- Other categories -->
      <div class="mt-16 border-t border-hairline pt-10 dark:border-hairline-dark">
        <p class="eyebrow">Explore Other Topics in {country.name}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {categories
            .filter((c) => c.id !== topic)
            .map((cat) => {
              const cCount = guides.filter((g) => g.country === countryCode && g.category === cat.id).length;
              if (cCount === 0) return null;
              return (
                <a
                  href={`${country.pathPrefix}/topics/${cat.id}/`}
                  class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-elevated px-3.5 py-1.5 text-xs font-medium text-body transition hover:border-link hover:text-link dark:border-hairline-dark dark:bg-canvas-elevated-dark dark:text-body-dark dark:hover:border-link-dark dark:hover:text-link-dark"
                >
                  <Icon name={cat.icon} class="size-3.5" />
                  <span>{cat.name}</span>
                  <span class="font-mono text-[10px] text-mute dark:text-mute-dark">({cCount})</span>
                </a>
              );
            })}
        </div>
      </div>
    </div>
  </section>
</Layout>
