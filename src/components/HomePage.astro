---
// Shared home page used by all three country routes:
//   /        (US — legacy URLs kept)
//   /uk      (United Kingdom)
//   /can     (Canada)
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import CountryFlag from './CountryFlag.astro';
import HeroFlowArt from './HeroFlowArt.astro';
import CardArt from './CardArt.astro';
import { guides, categories, countries, guidePath, getCountry, totalSteps } from '../data/guides';
import type { CountryCode } from '../data/guides';

interface Props {
  country: CountryCode;
}

const { country: code } = Astro.props;
const country = getCountry(code);
const countryGuides = guides.filter((g) => g.country === code);
const countrySteps = countryGuides.reduce((sum, g) => sum + g.steps.length, 0);
const totalDocuments = countryGuides.reduce((sum, g) => sum + g.documents.length, 0);

// Search index: title, summary, category name, and href per guide
// (lowercased copies for matching, display copies for the results dropdown)
const guideSearch = JSON.stringify(
  countryGuides.map((g) => {
    const cat = categories.find((c) => c.id === g.category)?.name ?? '';
    return {
      slug: g.slug,
      href: guidePath(g),
      title: g.title.toLowerCase(),
      summary: g.summary.toLowerCase(),
      cat: cat.toLowerCase(),
      displayTitle: g.title,
      displayCat: cat,
    };
  }),
);
---

<Layout
  title={`GovSteps — Step-by-Step Guides for ${country.name} Government Paperwork`}
  description={`Plain-language, step-by-step guides for ${country.name} government paperwork — taxes, immigration, passports, IDs, benefits, and business registration. Every step, fee, and waiting time, checked against official ${new Date().getFullYear()} sources.`}
>
  <!-- Country bar: horizontally centered pills, directly below the nav bar -->
  <div class="border-b border-hairline bg-canvas/70 dark:border-hairline-dark dark:bg-canvas-dark/70">
    <div class="container-geist flex flex-wrap items-center justify-center gap-2 py-2.5">
      <span class="mr-1.5 hidden font-mono text-[11px] font-medium uppercase tracking-wide text-mute sm:inline dark:text-mute-dark">Choose a country</span>
      {countries.map((c) => {
        const active = c.code === code;
        const count = guides.filter((g) => g.country === c.code).length;
        return (
          <a
            href={c.pathPrefix || '/'}
            aria-current={active ? 'page' : undefined}
            class={`inline-flex items-center gap-2 rounded-full border px-3.5 py-1.5 text-sm font-medium transition-all ${
              active
                ? 'border-ink bg-ink text-canvas dark:border-ink-dark dark:bg-ink-dark dark:text-canvas-dark'
                : 'border-hairline bg-canvas-elevated text-body hover:border-link hover:text-link dark:border-hairline-dark dark:bg-canvas-elevated-dark dark:text-body-dark dark:hover:border-link-dark dark:hover:text-link-dark'
            }`}
          >
            <CountryFlag code={c.code} class="h-4 w-6" />
            {c.name}
            <span class={`font-mono text-[10px] ${active ? 'opacity-70' : 'text-mute dark:text-mute-dark'}`}>{count}</span>
          </a>
        );
      })}
    </div>
  </div>

  <!-- hero-band: mesh gradient, display copy left, circular search pill right -->
  <section class="mesh-hero relative overflow-hidden border-b border-hairline dark:border-hairline-dark">
    <div class="huge-bg-word" aria-hidden="true"><span>GUIDES</span></div>
    <div class="container-geist relative z-10 py-8 sm:py-12 lg:py-16">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-16">
        <!-- Left: display copy -->
        <div class="hero-rise max-w-2xl" style="--d: 0">
          <p class="eyebrow hidden sm:block">Guides for citizens, immigrants & expats</p>
          <h1 class="display-xl mt-3 text-ink sm:mt-4 dark:text-ink-dark">
            {country.name} paperwork, <span class="text-link dark:text-link-dark">step by step.</span>
          </h1>
          <p class="mt-3 hidden text-sm text-body sm:mt-4 sm:block sm:text-base dark:text-body-dark">
            Which documents to gather, which office to visit, which form to fill, how long to wait, and what it costs — all in plain language.
          </p>
          <div class="mt-5 flex flex-wrap gap-3 sm:mt-6">
            <a href="#guides" class="hidden rounded-full bg-ink px-6 py-2.5 text-base font-medium leading-5 text-canvas hover:opacity-80 sm:inline-block dark:bg-ink-dark dark:text-canvas-dark">
              Browse All Guides
            </a>
            <a href="#categories" class="rounded-full border border-hairline bg-canvas-elevated px-6 py-2.5 text-base font-medium leading-5 text-ink hover:bg-hairline-soft dark:border-hairline-dark dark:bg-canvas-elevated-dark dark:text-ink-dark dark:hover:bg-hairline-soft-dark">
              Explore Categories
            </a>
          </div>
        </div>

        <!-- Right: circular search pill + live results dropdown -->
        <div class="hero-rise w-full max-w-md lg:ml-auto" style="--d: 1">
          <form data-guide-search role="search">
            <div class="relative">
              <div class="flex items-center rounded-full border border-hairline bg-canvas-elevated pr-2 shadow-[0px_4px_16px_rgba(0,0,0,0.06)] transition-[border-color,box-shadow] focus-within:border-link focus-within:shadow-[0px_8px_30px_rgba(0,112,243,0.15)] dark:border-hairline-dark dark:bg-canvas-elevated-dark dark:focus-within:border-link-dark">
                <input
                  type="search"
                  name="q"
                  placeholder={`Search ${countryGuides.length} ${country.short} guides — passport, visa, taxes…`}
                  aria-label="Search guides"
                  aria-expanded="false"
                  aria-controls="search-results"
                  autocomplete="off"
                  class="h-14 w-full min-w-0 rounded-l-full bg-transparent pl-6 text-base text-ink outline-none placeholder:text-mute dark:text-ink-dark dark:placeholder:text-mute-dark"
                />
                <button
                  type="submit"
                  aria-label="Search guides"
                  class="grid size-10 shrink-0 place-items-center rounded-full bg-ink text-canvas transition hover:opacity-80 dark:bg-ink-dark dark:text-canvas-dark"
                >
                  <Icon name="search" class="size-4" />
                </button>
              </div>
              <!-- Live results: rendered by the search script as you type -->
              <div
                id="search-results"
                data-search-results
                class="absolute inset-x-0 top-full z-40 mt-2 hidden overflow-hidden rounded-2xl border border-hairline bg-canvas-elevated shadow-[0px_8px_30px_rgba(0,0,0,0.10)] dark:border-hairline-dark dark:bg-canvas-elevated-dark"
              ></div>
            </div>
          </form>
          <!-- decorative flow: document → steps → done (original vector art) -->
          <HeroFlowArt class="mt-6 hidden w-full sm:block" />
        </div>
      </div>
    </div>
  </section>

  <!-- stats strip: compact inline row, number + label side by side -->
  <section class="border-b border-hairline dark:border-hairline-dark">
    <div class="container-geist flex flex-wrap items-center justify-center gap-x-6 gap-y-1 py-3 sm:justify-start sm:gap-x-8 sm:py-4">
      <p class="inline-flex items-center gap-1.5 text-sm text-body dark:text-body-dark">
        <CountryFlag code={code} class="h-3.5 w-5" />
        <span class="font-semibold text-ink dark:text-ink-dark">{country.name}</span>
      </p>
      <p class="inline-flex items-center gap-1.5 text-sm text-body dark:text-body-dark">
        <Icon name="list" class="size-3.5 text-mute dark:text-mute-dark" />
        <span class="font-semibold text-ink dark:text-ink-dark">{countryGuides.length}</span> guides
      </p>
      <p class="inline-flex items-center gap-1.5 text-sm text-body dark:text-body-dark">
        <Icon name="check" class="size-3.5 text-mute dark:text-mute-dark" />
        <span class="font-semibold text-ink dark:text-ink-dark">{countrySteps}</span> steps
      </p>
      <p class="inline-flex items-center gap-1.5 text-sm text-body dark:text-body-dark">
        <Icon name="file" class="size-3.5 text-mute dark:text-mute-dark" />
        <span class="font-semibold text-ink dark:text-ink-dark">{totalDocuments}</span> documents listed
      </p>
      <p class="inline-flex items-center gap-1.5 text-sm text-body dark:text-body-dark">
        <Icon name="heart" class="size-3.5 text-mute dark:text-mute-dark" />
        <span class="font-semibold text-ink dark:text-ink-dark">100%</span> free to read
      </p>
    </div>
  </section>

  <!-- Categories: full-bleed grey panel band, hairline feature-card grid -->
  <section id="categories" class="border-b border-hairline bg-hairline-soft/60 dark:border-hairline-dark dark:bg-hairline-soft-dark/40">
    <div class="container-geist py-8 sm:py-12 lg:py-16">
      <div class="max-w-2xl">
        <p class="eyebrow">Categories</p>
        <h2 class="heading-lg mt-2 text-ink dark:text-ink-dark">Browse by topic</h2>
        <p class="mt-2 text-sm text-body sm:mt-3 sm:text-base dark:text-body-dark">One format: documents, offices, forms, waits, and costs — in the order you actually live them.</p>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:mt-8 lg:grid-cols-3">
        {categories.map((cat) => {
          const count = countryGuides.filter((g) => g.category === cat.id).length;
          if (count === 0) return null;
          return (
            <a
              href={`#cat-${cat.id}`}
              class="group rounded-md border border-hairline bg-canvas-elevated p-6 transition-shadow hover:shadow-[0px_2px_2px_rgba(0,0,0,0.04)] dark:border-hairline-dark dark:bg-canvas-elevated-dark"
            >
              <span class="grid size-10 place-items-center rounded-md border border-hairline bg-canvas text-ink dark:border-hairline-dark dark:bg-canvas-dark dark:text-ink-dark">
                <Icon name={cat.icon} class="size-5" />
              </span>
              <h3 class="heading-md mt-4 text-ink group-hover:text-link dark:text-ink-dark dark:group-hover:text-link-dark">{cat.name}</h3>
              <p class="mt-1.5 text-sm text-body dark:text-body-dark">{cat.blurb}</p>
              <p class="mt-4 font-mono text-xs text-mute dark:text-mute-dark">
                {count} guides
              </p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Guides: canvas band -->
  <section id="guides" class="py-8 sm:py-12 lg:py-16">
    <div class="container-geist">
      <div class="max-w-2xl">
        <p class="eyebrow">All Guides</p>
        <h2 class="heading-lg mt-2 text-ink dark:text-ink-dark">Every {country.short} guide, start to finish</h2>
        <p class="mt-2 text-sm text-body sm:mt-3 sm:text-base dark:text-body-dark">
          Each guide includes a document checklist, a step timeline, official links, and answers to the questions people actually ask.
        </p>
      </div>

      {categories.map((cat) => {
        const catGuides = countryGuides.filter((g) => g.category === cat.id);
        if (catGuides.length === 0) return null;
        return (
          <div id={`cat-${cat.id}`} class="mt-10 scroll-mt-24 sm:mt-14 lg:mt-16">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline pb-4 dark:border-hairline-dark">
              <h3 class="flex items-center gap-2.5 text-lg font-semibold text-ink dark:text-ink-dark">
                <span class="grid size-6 place-items-center text-ink dark:text-ink-dark">
                  <Icon name={cat.icon} class="size-5" />
                </span>
                {cat.name}
              </h3>
              <p class="font-mono text-xs text-mute dark:text-mute-dark">{catGuides.length} guides</p>
            </div>
            <div class="mt-6 grid gap-4 md:grid-cols-2">
              {catGuides.map((guide, i) => (
                <a
                  href={guidePath(guide)}
                  data-guide-card
                  data-slug={guide.slug}
                  data-collapsed={i >= 4 ? 'true' : 'false'}
                  style={i >= 4 ? 'display:none' : undefined}
                  class="group relative overflow-hidden rounded-md border border-hairline bg-canvas-elevated p-5 transition-all hover:-translate-y-0.5 hover:border-link hover:shadow-[0px_2px_2px_rgba(0,0,0,0.04)] dark:border-hairline-dark dark:bg-canvas-elevated-dark dark:hover:border-link-dark"
                >
                  <!-- B&W line-art scene, bottom-right, subtle -->
                  <CardArt
                    category={guide.category}
                    class="pointer-events-none absolute -right-4 -bottom-5 size-28 text-ink opacity-[0.06] transition-opacity duration-300 group-hover:opacity-[0.12] dark:text-ink-dark dark:opacity-[0.08] dark:group-hover:opacity-[0.16]"
                  />
                  <div class="relative">
                    <h4 class="flex items-start justify-between gap-2 text-base font-semibold leading-snug text-ink group-hover:text-link dark:text-ink-dark dark:group-hover:text-link-dark">
                      {guide.title}
                      <Icon name="arrowright" class="mt-0.5 size-4 shrink-0 -translate-x-1 text-mute opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:text-link group-hover:opacity-100 dark:text-mute-dark dark:group-hover:text-link-dark" />
                    </h4>
                    <p class="mt-1.5 line-clamp-1 text-sm text-body dark:text-body-dark">{guide.summary}</p>
                    <p class="mt-3 flex flex-wrap items-center gap-x-2 font-mono text-xs text-mute dark:text-mute-dark">
                      <span>{guide.steps.length} steps · {guide.totalTime}</span>
                      {guide.updatedAt && (
                        <span class="rounded-full bg-hairline-soft px-2 py-0.5 text-[10px] font-medium text-link-deep dark:bg-hairline-soft-dark dark:text-link-dark">
                          {guide.updatedAt}-Latest
                        </span>
                      )}
                    </p>
                  </div>
                </a>
              ))}
            </div>
            {catGuides.length > 4 && (
              <button
                type="button"
                data-toggle-cat={cat.id}
                data-expanded="false"
                class="mt-4 inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas-elevated px-4 py-1.5 text-sm font-medium text-ink transition hover:border-link hover:text-link dark:border-hairline-dark dark:bg-canvas-elevated-dark dark:text-ink-dark dark:hover:border-link-dark dark:hover:text-link-dark"
              >
                <span>Show all {catGuides.length} guides</span>
                <Icon name="arrowright" class="size-3.5 rotate-90 transition-transform" />
              </button>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <!-- cta-band: end-of-page call to action (full-bleed band, centered content) -->
  <section class="border-t border-hairline dark:border-hairline-dark">
    <div class="container-geist py-8 text-center sm:py-12 lg:py-16">
      <h2 class="heading-lg text-ink dark:text-ink-dark">Stop guessing. Start with step one.</h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-body dark:text-body-dark">
        Every guide is free, plain-language, and ends with exactly what you receive when it's done.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="#guides" class="rounded-full bg-ink px-6 py-2.5 text-base font-medium leading-5 text-canvas hover:opacity-80 dark:bg-ink-dark dark:text-canvas-dark">
          Browse All Guides
        </a>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ guideSearch }}>
  const guideIndex = JSON.parse(guideSearch);

  function setupGuideSearch() {
    const form = document.querySelector('[data-guide-search]');
    const input = form?.querySelector('input[name="q"]');
    const dropdown = form?.querySelector('[data-search-results]');
    if (!form || !input || !dropdown) return;

    // Every guide card on the page carries its slug; category headers carry
    // their category id so empty categories can be hidden while filtering.
    const cards = Array.from(document.querySelectorAll('[data-guide-card]'));
    const catSections = Array.from(document.querySelectorAll('[id^="cat-"]'));
    const toggles = Array.from(document.querySelectorAll('[data-toggle-cat]'));

    // "Show all N guides" per category: reveal the cards hidden by the collapse
    toggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('data-expanded') === 'true';
        btn.setAttribute('data-expanded', expanded ? 'false' : 'true');
        const label = btn.querySelector('span');
        const total = btn.closest('[id^="cat-"]')?.querySelectorAll('[data-guide-card]').length ?? 0;
        if (label) label.textContent = expanded ? `Show all ${total} guides` : 'Show fewer';
        const arrow = btn.querySelector('svg');
        arrow?.classList.toggle('-rotate-90', !expanded);
        btn.closest('[id^="cat-"]')?.querySelectorAll('[data-guide-card]').forEach((card) => {
          if (card.getAttribute('data-collapsed') === 'true') {
            card.style.display = expanded ? 'none' : '';
          }
        });
      });
    });
    const noResults = (() => {
      const el = document.createElement('p');
      el.className = 'mt-10 hidden rounded-md border border-hairline bg-canvas-elevated p-6 text-sm text-body dark:border-hairline-dark dark:bg-canvas-elevated-dark dark:text-body-dark';
      el.textContent = 'No guides match that search. Try "passport", "visa", "taxes", or "ID".';
      const guidesSection = document.querySelector('#guides .container-geist');
      guidesSection?.appendChild(el);
      return el;
    })();

    // Multi-word AND matching: every word must appear in title/summary/category.
    // "passport renew" matches "How to renew a passport" (both words present).
    function matches(g, words) {
      const haystack = `${g.title} ${g.summary} ${g.cat}`;
      return words.every((w) => haystack.includes(w));
    }

    let activeIndex = -1; // keyboard-selected row in the dropdown

    function renderDropdown(q, results) {
      dropdown.innerHTML = '';

      if (!q) {
        dropdown.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
        return;
      }

      const header = document.createElement('p');
      header.className = 'border-b border-hairline px-4 py-2.5 font-mono text-[11px] uppercase text-mute dark:border-hairline-dark dark:text-mute-dark';
      header.textContent = results.length > 0
        ? `${results.length} guide${results.length === 1 ? '' : 's'} found`
        : 'No guides found';
      dropdown.appendChild(header);

      if (results.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'px-4 py-3 text-sm text-body dark:text-body-dark';
        empty.textContent = 'Try "passport", "visa", "taxes", or "ID".';
        dropdown.appendChild(empty);
      } else {
        results.slice(0, 6).forEach((g, i) => {
          const a = document.createElement('a');
          a.href = g.href;
          a.className = 'flex items-center justify-between gap-3 px-4 py-3 text-sm text-ink hover:bg-hairline-soft dark:text-ink-dark dark:hover:bg-hairline-soft-dark';
          a.setAttribute('data-index', String(i));
          const title = document.createElement('span');
          title.className = 'font-medium';
          title.textContent = g.displayTitle;
          const cat = document.createElement('span');
          cat.className = 'shrink-0 font-mono text-[11px] text-mute dark:text-mute-dark';
          cat.textContent = g.displayCat;
          a.append(title, cat);
          dropdown.appendChild(a);
        });
        if (results.length > 6) {
          const more = document.createElement('p');
          more.className = 'border-t border-hairline px-4 py-2.5 text-xs text-mute dark:border-hairline-dark dark:text-mute-dark';
          more.textContent = `+ ${results.length - 6} more below`;
          dropdown.appendChild(more);
        }
      }

      dropdown.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
      activeIndex = -1;
    }

    function applyFilter() {
      const q = input.value.trim().toLowerCase();
      const words = q ? q.split(/\s+/).filter(Boolean) : [];
      const visible = new Set();
      const results = [];

      guideIndex.forEach((g) => {
        if (!words.length || matches(g, words)) {
          visible.add(g.slug);
          if (words.length) results.push(g);
        }
      });

      // Filter the full guide list further down the page.
      // While searching, the collapse is ignored (every match shows);
      // with an empty query, each category returns to its collapsed state.
      const searching = words.length > 0;
      cards.forEach((card) => {
        const slug = card.getAttribute('data-slug');
        if (!slug) return;
        if (searching) {
          card.style.display = visible.has(slug) ? '' : 'none';
        } else {
          card.style.display = card.getAttribute('data-collapsed') === 'true' ? 'none' : '';
        }
      });

      // Hide the per-category toggles while searching (all matches are shown);
      // when the query clears, reset every toggle back to its collapsed state
      toggles.forEach((btn) => {
        btn.style.display = searching ? 'none' : '';
        if (!searching && btn.getAttribute('data-expanded') === 'true') {
          btn.setAttribute('data-expanded', 'false');
          const label = btn.querySelector('span');
          const total = btn.closest('[id^="cat-"]')?.querySelectorAll('[data-guide-card]').length ?? 0;
          if (label) label.textContent = `Show all ${total} guides`;
          btn.querySelector('svg')?.classList.remove('-rotate-90');
        }
      });

      catSections.forEach((section) => {
        const anyVisible = Array.from(
          section.querySelectorAll('[data-guide-card]'),
        ).some((c) => c.style.display !== 'none');
        section.style.display = anyVisible ? '' : 'none';
      });

      noResults.classList.toggle('hidden', !words.length || visible.size > 0);

      // Live dropdown under the search pill
      renderDropdown(q, results);
    }

    function scrollToGuides() {
      document.getElementById('guides')?.scrollIntoView({ behavior: 'smooth' });
    }

    input.addEventListener('input', applyFilter);

    // Submit (Enter or the circular button) scrolls to the filtered list
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (input.value.trim()) scrollToGuides();
    });

    // Keyboard navigation inside the dropdown: arrows + Enter opens a result
    input.addEventListener('keydown', (e) => {
      const links = Array.from(dropdown.querySelectorAll('a[data-index]'));
      if (!links.length || dropdown.classList.contains('hidden')) return;

      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = e.key === 'ArrowDown'
          ? (activeIndex + 1) % links.length
          : (activeIndex - 1 + links.length) % links.length;
        links.forEach((l, i) => {
          const on = i === activeIndex;
          l.classList.toggle('bg-hairline-soft', on);
          l.classList.toggle('dark:bg-hairline-soft-dark', on);
        });
        links[activeIndex]?.focus({ preventScroll: true });
      } else if (e.key === 'Enter' && activeIndex >= 0) {
        e.preventDefault();
        links[activeIndex]?.click();
      } else if (e.key === 'Escape') {
        dropdown.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
      }
    });

    // Clicking outside closes the dropdown
    document.addEventListener('click', (e) => {
      if (!form.contains(e.target)) {
        dropdown.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
      }
    });

  }

  document.addEventListener('astro:page-load', setupGuideSearch);
  setupGuideSearch();
</script>

<style>
  /* Hero load reveal: staggered fade-up, disabled for reduced motion */
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-rise {
    animation: hero-rise 0.7s cubic-bezier(0.2, 0.7, 0.3, 1) both;
    animation-delay: calc(var(--d, 0) * 130ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-rise {
      animation: none;
    }
  }
</style>
