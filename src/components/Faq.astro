---
import Icon from './Icon.astro';
import { linkTerms } from '../data/glossary';

interface Props {
  faqs: { q: string; a: string }[];
}

const { faqs } = Astro.props;
---

<div class="space-y-3">
  {faqs.map((faq) => (
    <details data-doc-details class="group rounded-md border border-hairline bg-canvas-elevated p-4 transition-shadow open:shadow-[0px_2px_2px_rgba(0,0,0,0.04)] dark:border-hairline-dark dark:bg-canvas-elevated-dark">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold text-ink dark:text-ink-dark [&::-webkit-details-marker]:hidden">
        <span class="flex items-start gap-2.5">
          <Icon name="question" class="mt-0.5 size-4 shrink-0 text-mute dark:text-mute-dark" />
          {faq.q}
        </span>
        <svg class="size-4 shrink-0 text-mute transition-transform group-open:rotate-180 dark:text-mute-dark" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <p class="mt-3 text-sm leading-relaxed text-body dark:text-body-dark" set:html={linkTerms(faq.a)} />
    </details>
  ))}
</div>

<!-- FAQPage structured data is emitted via the Layout `schema` prop on guide pages. -->
