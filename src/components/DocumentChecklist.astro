---
import Icon from './Icon.astro';
import { linkTerms } from '../data/glossary';

interface Props {
  documents: string[];
}

const { documents } = Astro.props;
---

<div class="doc-card rounded-lg border p-5 sm:p-6 shadow-sm">
  <h3 class="doc-title flex items-center gap-2.5 text-base font-semibold leading-snug">
    <Icon name="folder" class="size-5 shrink-0 text-link dark:text-link-dark" />
    <span>Documents to Bring / Prepare</span>
  </h3>
  <p class="doc-subtitle mt-1.5 text-sm font-normal">
    Tap each item to check it off as you gather your papers.
  </p>
  <ul class="mt-4 space-y-2">
    {documents.map((doc, idx) => (
      <li>
        <label class="doc-item group flex cursor-pointer items-start gap-3 rounded-md border p-3.5 text-sm font-medium leading-snug transition-all">
          <input
            type="checkbox"
            id={`doc-check-${idx}`}
            class="doc-checkbox mt-0.5 size-4 shrink-0 rounded-sm accent-link dark:accent-link-dark"
            aria-label={doc}
          />
          <span class="doc-text flex-1 select-none" set:html={linkTerms(doc)} />
        </label>
      </li>
    ))}
  </ul>
</div>

<style>
  /* Guaranteed contrast & visibility in all environments (light, dark, system, or forced mode) */
  :root {
    --doc-card-bg: #ffffff;
    --doc-card-border: #e5e7eb;
    --doc-item-bg: #f8fafc;
    --doc-item-border: #cbd5e1;
    --doc-text-color: #0f172a;
    --doc-subtext-color: #334155;
  }

  :global(.dark) {
    --doc-card-bg: #111111;
    --doc-card-border: #262626;
    --doc-item-bg: #1e1e20;
    --doc-item-border: #333336;
    --doc-text-color: #f4f4f5;
    --doc-subtext-color: #a1a1aa;
  }

  @media (prefers-color-scheme: dark) {
    :root:not(.light) {
      --doc-card-bg: #111111;
      --doc-card-border: #262626;
      --doc-item-bg: #1e1e20;
      --doc-item-border: #333336;
      --doc-text-color: #f4f4f5;
      --doc-subtext-color: #a1a1aa;
    }
  }

  .doc-card {
    background-color: var(--doc-card-bg) !important;
    border-color: var(--doc-card-border) !important;
  }

  .doc-title {
    color: var(--doc-text-color) !important;
  }

  .doc-subtitle {
    color: var(--doc-subtext-color) !important;
  }

  .doc-item {
    background-color: var(--doc-item-bg) !important;
    border-color: var(--doc-item-border) !important;
    color: var(--doc-text-color) !important;
    opacity: 1 !important;
  }

  .doc-item:hover {
    border-color: #0070f3 !important;
  }

  :global(.dark) .doc-item:hover {
    border-color: #3291ff !important;
  }

  .doc-checkbox {
    accent-color: #0070f3 !important;
  }

  :global(.dark) .doc-checkbox {
    accent-color: #3291ff !important;
  }

  /* Make sure every span, abbr, and text node inherits full high contrast text color */
  .doc-text,
  .doc-text :global(*:not([role="tooltip"])) {
    color: var(--doc-text-color) !important;
  }

  /* Checked state: strikethrough with dimming */
  .doc-item:has(input:checked),
  .doc-item.is-checked {
    opacity: 0.65 !important;
  }

  .doc-item:has(input:checked) .doc-text,
  .doc-item.is-checked .doc-text {
    text-decoration: line-through !important;
    text-decoration-color: currentColor !important;
  }
</style>

<script>
  function setupCheckboxes() {
    document.querySelectorAll('.doc-item input[type="checkbox"]').forEach((cb) => {
      const input = cb as HTMLInputElement;
      const label = input.closest('.doc-item');
      if (!label) return;
      label.classList.toggle('is-checked', input.checked);
      input.addEventListener('change', () => {
        label.classList.toggle('is-checked', input.checked);
      });
    });
  }
  setupCheckboxes();
  document.addEventListener('astro:page-load', setupCheckboxes);
</script>
