---
import Icon from './Icon.astro';
import { linkTerms } from '../data/glossary';

interface Props {
  documents: string[];
}

const { documents } = Astro.props;
---

<div class="rounded-xl border border-slate-200 bg-slate-50/75 p-5 sm:p-6 shadow-xs dark:border-neutral-800 dark:bg-neutral-900/90">
  <h3 class="flex items-center gap-2.5 text-base font-bold text-slate-900 dark:text-white">
    <Icon name="folder" class="size-5 shrink-0 text-blue-600 dark:text-blue-400" />
    <span>Documents to Bring / Prepare</span>
  </h3>
  <p class="mt-1.5 text-sm font-normal text-slate-600 dark:text-neutral-300">Tap each item to check it off as you gather your papers.</p>
  <ul class="mt-4 space-y-2">
    {documents.map((doc) => (
      <li>
        <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200/90 bg-white p-3.5 text-sm font-medium leading-snug text-slate-900 shadow-xs transition-all hover:border-blue-500 hover:bg-blue-50/20 has-[:checked]:opacity-50 has-[:checked]:line-through dark:border-neutral-700/80 dark:bg-neutral-800 dark:text-neutral-100 dark:hover:border-blue-400 dark:hover:bg-neutral-700/60">
          <input
            type="checkbox"
            class="mt-0.5 size-4 shrink-0 rounded accent-blue-600 dark:accent-blue-400"
            aria-label={doc}
          />
          <span class="text-slate-900 dark:text-neutral-100" set:html={linkTerms(doc)} />
        </label>
      </li>
    ))}
  </ul>
</div>
