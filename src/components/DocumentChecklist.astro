---
import Icon from './Icon.astro';

interface Props {
  documents: string[];
}

const { documents } = Astro.props;
---

<div class="doc-card rounded-lg border p-4 sm:p-5 shadow-sm" style="background-color: var(--doc-card-bg); border-color: var(--doc-card-border);">
  <h3 class="doc-title flex items-center gap-2 text-base font-bold leading-snug" style="color: var(--doc-title);">
    <Icon name="folder" class="size-5 shrink-0 text-link dark:text-link-dark" />
    <span>Documents to Bring / Prepare</span>
  </h3>
  <p class="doc-subtitle mt-1 text-xs sm:text-sm font-normal" style="color: var(--doc-subtitle);">
    Tap each item to check it off as you gather your papers.
  </p>
  <ul class="mt-3 space-y-2">
    {documents.map((doc, idx) => (
      <li>
        <label
          class="doc-item group flex cursor-pointer items-start gap-3 rounded-md border p-3 text-sm font-medium leading-snug transition-all"
          style="background-color: var(--doc-bg); border-color: var(--doc-border); color: var(--doc-text);"
        >
          <input
            type="checkbox"
            id={`doc-check-${idx}`}
            class="doc-checkbox mt-0.5 size-4 shrink-0 rounded-sm"
            aria-label={doc}
          />
          <span
            class="doc-text flex-1 select-none font-semibold"
            style="color: var(--doc-text) !important; visibility: visible !important; display: inline-block !important;"
          >
            {doc}
          </span>
        </label>
      </li>
    ))}
  </ul>
</div>

<style>
  /* Guaranteed 100% font visibility & ultra-high contrast across all browsers/themes */
  :root {
    --doc-text: #09090b;
    --doc-bg: #ffffff;
    --doc-border: #cbd5e1;
    --doc-card-bg: #f8fafc;
    --doc-card-border: #e2e8f0;
    --doc-title: #09090b;
    --doc-subtitle: #334155;
  }

  :global(.dark),
  .dark {
    --doc-text: #ffffff;
    --doc-bg: #18181b;
    --doc-border: #3f3f46;
    --doc-card-bg: #09090b;
    --doc-card-border: #27272a;
    --doc-title: #ffffff;
    --doc-subtitle: #d4d4d8;
  }

  @media (prefers-color-scheme: dark) {
    :root:not(.light) {
      --doc-text: #ffffff;
      --doc-bg: #18181b;
      --doc-border: #3f3f46;
      --doc-card-bg: #09090b;
      --doc-card-border: #27272a;
      --doc-title: #ffffff;
      --doc-subtitle: #d4d4d8;
    }
  }

  .doc-card {
    background-color: var(--doc-card-bg) !important;
    border-color: var(--doc-card-border) !important;
  }

  .doc-title {
    color: var(--doc-title) !important;
  }

  .doc-subtitle {
    color: var(--doc-subtitle) !important;
  }

  .doc-item {
    background-color: var(--doc-bg) !important;
    border-color: var(--doc-border) !important;
    color: var(--doc-text) !important;
    opacity: 1 !important;
  }

  .doc-item:hover {
    border-color: #0070f3 !important;
  }

  :global(.dark) .doc-item:hover,
  .dark .doc-item:hover {
    border-color: #3291ff !important;
  }

  .doc-checkbox {
    accent-color: #0070f3 !important;
  }

  :global(.dark) .doc-checkbox,
  .dark .doc-checkbox {
    accent-color: #3291ff !important;
  }

  /* Force font visibility on the label text node */
  .doc-text {
    color: #09090b !important;
    color: var(--doc-text, #09090b) !important;
    font-size: 0.875rem !important;
    font-weight: 600 !important;
    line-height: 1.375 !important;
    visibility: visible !important;
    opacity: 1 !important;
    display: inline-block !important;
  }

  :global(.dark) .doc-text,
  .dark .doc-text {
    color: #ffffff !important;
    color: var(--doc-text, #ffffff) !important;
  }

  /* Checked state: strikethrough with dimming */
  .doc-item:has(input:checked),
  .doc-item.is-checked {
    opacity: 0.65 !important;
  }

  .doc-item:has(input:checked) .doc-text,
  .doc-item.is-checked .doc-text {
    text-decoration: line-through !important;
    text-decoration-color: currentColor !important;
  }
</style>

<script>
  function setupCheckboxes() {
    document.querySelectorAll('.doc-item input[type="checkbox"]').forEach((cb) => {
      const input = cb as HTMLInputElement;
      const label = input.closest('.doc-item');
      if (!label) return;
      label.classList.toggle('is-checked', input.checked);
      input.addEventListener('change', () => {
        label.classList.toggle('is-checked', input.checked);
      });
    });
  }
  setupCheckboxes();
  document.addEventListener('astro:page-load', setupCheckboxes);
</script>
