---
// Original B&W line-art scene per guide category, used as a subtle card
// background. Hand-authored SVG (license-safe by construction — no external
// assets), stroke-based like the rest of the site's vector art.
interface Props {
  category: string;
  class?: string;
}

const { category, class: cls = '' } = Astro.props;

// One relatable "scene" per category: the objects you actually deal with.
const scenes: Record<string, string> = {
  // Taxes: receipt + calculator + coins
  taxes: `
    <path d="M28 18c0-2.2 1.8-4 4-4h44c2.2 0 4 1.8 4 4v70l-8-5-8 5-8-5-8 5-8-5-8 5V18Z"/>
    <path d="M38 30h32M38 40h32M38 50h20"/>
    <rect x="70" y="52" width="34" height="42" rx="4"/>
    <path d="M76 60h6M86 60h6M76 70h6M86 70h6M76 80h6M86 80h6M96 60v20"/>
    <circle cx="34" cy="86" r="9"/><circle cx="52" cy="92" r="7"/>
    <path d="M34 82v8M31 86h6"/>`,
  // Immigration: passport + globe + plane
  immigration: `
    <rect x="20" y="24" width="44" height="60" rx="4"/>
    <circle cx="42" cy="34" r="7"/>
    <path d="M30 48h24M30 56h24M30 64h16"/>
    <circle cx="82" cy="58" r="22"/>
    <path d="M60 58h44M82 36c8 8 8 36 0 44M82 36c-8 8-8 36 0 44"/>
    <path d="M96 20l10 3-3 10M96 20l-8 8"/>
    <path d="M96 20 60 56"/>`,
  // IDs & Licenses: ID card + passport book
  ids: `
    <rect x="16" y="40" width="56" height="36" rx="4"/>
    <circle cx="32" cy="54" r="6"/>
    <path d="M24 68c2-4 6-6 8-6s6 2 8 6"/>
    <path d="M52 52h12M52 60h12"/>
    <rect x="72" y="30" width="36" height="48" rx="4"/>
    <path d="M78 30v48M84 40h18M84 48h18M84 56h12"/>
    <circle cx="96" cy="70" r="3"/>`,
  // Benefits & Health: heart in hand + shield
  benefits: `
    <path d="M60 78c-14-10-26-18-26-30a12 12 0 0 1 22-6 12 12 0 0 1 22 6c0 12-12 20-18 30Z"/>
    <path d="M24 88c8-6 16-6 24-2s16 4 24-2"/>
    <path d="M88 26l10 4v10c0 8-4 14-10 17-6-3-10-9-10-17V30Z"/>
    <path d="M85 40l3 3 5-6"/>`,
  // Business: briefcase + building + coin
  business: `
    <rect x="20" y="46" width="40" height="28" rx="3"/>
    <path d="M32 46v-6a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v6M20 58h40"/>
    <rect x="66" y="26" width="34" height="48" rx="2"/>
    <path d="M73 34h6M81 34h6M89 34h4M73 42h6M81 42h6M89 42h4M73 50h6M81 50h6M89 50h4M73 58h6M81 58h6M89 58h4"/>
    <path d="M83 74v10h24"/>
    <circle cx="40" cy="88" r="8"/><path d="M40 84v8M37 88h6"/>`,
  // Accidents & Emergencies: car + warning triangle
  accidents: `
    <path d="M18 72v-8c0-2 1-3 3-4l7-12c1-2 3-3 5-3h26c2 0 4 1 5 3l7 12c2 1 3 2 3 4v8"/>
    <rect x="14" y="70" width="52" height="12" rx="3"/>
    <circle cx="26" cy="86" r="6"/><circle cx="54" cy="86" r="6"/>
    <path d="M30 50h20l4 10H26Z"/>
    <path d="M84 34l12 20H72Z"/>
    <path d="M84 42v6M84 50h.01"/>`,
  // Students: grad cap + open book + pencil
  students: `
    <path d="M60 22 26 36l34 14 34-14Z"/>
    <path d="M40 44v14c0 4 9 8 20 8s20-4 20-8V44"/>
    <path d="M94 36v16"/>
    <path d="M30 66h24l-4 24H18Z"/>
    <path d="M42 66v24"/>
    <path d="M78 66l14-6 6 22-14 6Z"/>
    <path d="M82 76l8-2"/>`,
  // Civic Life: ballot box + flag + checkmark vote
  civic: `
    <rect x="24" y="46" width="44" height="34" rx="3"/>
    <path d="M36 46v-6h20v6"/>
    <path d="M46 52l-6 8h5l-1 6 7-9h-5Z"/>
    <path d="M78 30h24l-6 8 6 8H78"/>
    <path d="M78 30v46"/>
    <path d="M30 88h32"/>`,
};

const markup = scenes[category] ?? scenes.ids;
---

<svg
  class={cls}
  viewBox="0 0 120 120"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={markup}
/>
