---
// Shared guide-page layout used by all country routes:
//   /guides/[slug]        (US — legacy URLs kept)
//   /uk/guides/[slug]     (UK)
//   /can/guides/[slug]    (Canada)
//   /uae/guides/[slug]    (UAE)
import Layout from '../layouts/Layout.astro';
import StepTimeline from './StepTimeline.astro';
import Calculator from './Calculator.astro';
import DocumentChecklist from './DocumentChecklist.astro';
import InfoBox from './InfoBox.astro';
import Faq from './Faq.astro';
import Icon from './Icon.astro';
import CategorySticker from './CategorySticker.astro';
import TranslateGuide from './TranslateGuide.astro';
import CountryFlag from './CountryFlag.astro';
import ShareButtons from './ShareButtons.astro';
import { categories, guidePath, getCountry, guides } from '../data/guides';
import type { Guide } from '../data/guides';
import { linkTerms, resetPageGlossary } from '../data/glossary';
import { getGuideEditorial } from '../data/types';
import { getGuideHero, getGuideOgImage } from '../data/guideImages';
import { toIso8601Duration } from '../utils/duration';

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;

// Reset glossary terms seen on this page so only the first instance of each term gets an interactive tooltip
resetPageGlossary();

const country = getCountry(guide.country);
const category = categories.find((c) => c.id === guide.category);
const editorial = getGuideEditorial(guide);

// SEO: render the meta title with a dynamic freshness year derived from the
// guide's last review date, so hardcoded "(2025)"-style suffixes never go stale
// in SERPs. Only the first "(YYYY ...)" group is replaced; titles without a
// year suffix are left untouched.
const reviewYear = editorial.lastReviewedDate?.slice(0, 4) ?? guide.updatedAt ?? '2026';
const metaTitle = guide.metaTitle.replace(/\(20\d{2}([^)]*)\)/, `(${reviewYear}$1)`);
const heroImg = getGuideHero(guide);
const homeHref = country.pathPrefix ? `${country.pathPrefix}/` : '/';
const topicHref = `${country.pathPrefix ? country.pathPrefix : ''}/topics/${guide.category}/`;

// Select 4 to 6 related guides: same category first, then same country
const sameCategoryRelated = guides.filter(
  (g) => g.country === guide.country && g.category === guide.category && g.slug !== guide.slug
);
const otherCategoryRelated = guides.filter(
  (g) => g.country === guide.country && g.category !== guide.category && g.slug !== guide.slug
);
const related = [...sameCategoryRelated, ...otherCategoryRelated].slice(0, 6);

// --- SEO structured data ---------------------------------------------
const guideUrl = new URL(guidePath(guide), Astro.site).toString();
const ogImageUrl = getGuideOgImage(guide, Astro.site ? new URL(Astro.site).origin : 'https://govsteps.com');
const heroFullUrl = new URL(heroImg.src, Astro.site).toString();

// First official (external) link found across steps — used for the "official site" CTA
const officialLink = guide.steps
  .flatMap((s) => s.links ?? [])
  .find((l) => /^https?:\/\//.test(l.href));

const stepToHowToStep = (step: (typeof guide.steps)[number], i: number) => {
  const durationIso = toIso8601Duration(step.duration);
  return {
    '@type': 'HowToStep',
    position: i + 1,
    name: step.title,
    text: step.detail,
    ...(durationIso ? { timeRequired: durationIso } : {}),
  };
};

const totalTimeIso = toIso8601Duration(guide.totalTime);

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: guide.title,
  description: guide.description,
  image: heroFullUrl,
  ...(totalTimeIso ? { totalTime: totalTimeIso } : {}),
  // dateModified: exact review date when one is recorded, else the
  // coarse updatedAt year — never a fabricated day.
  ...(editorial.lastReviewedDate
    ? { dateModified: editorial.lastReviewedDate }
    : guide.updatedAt
      ? { dateModified: guide.updatedAt }
      : {}),
  inLanguage: 'en',
  author: {
    '@type': 'Organization',
    name: 'GovSteps Editorial Team',
    url: new URL('/about/', Astro.site).toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'GovSteps',
    url: new URL('/', Astro.site).toString(),
  },
  ...(guide.totalCost
    ? {
        estimatedCost: {
          '@type': 'MonetaryAmount',
          currency: guide.country === 'uk' ? 'GBP' : guide.country === 'ca' ? 'CAD' : 'USD',
          description: guide.totalCost,
        },
      }
    : {}),
  step: guide.steps.map(stepToHowToStep),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: `${country.short} Guides`,
      item: new URL(homeHref, Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: category?.name ?? 'Topic',
      item: new URL(topicHref, Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: guide.title,
      item: guideUrl,
    },
  ],
};
---

<Layout
  title={metaTitle}
  description={guide.description}
  ogImage={ogImageUrl}
  schema={[howToSchema, faqSchema, breadcrumbSchema]}
>
  <!-- Hero band: grey panel, breadcrumb + title + summary + quick facts -->
  <section class="relative overflow-hidden border-b border-hairline bg-hairline-soft/60 dark:border-hairline-dark dark:bg-hairline-soft-dark/40">
    <div class="huge-bg-word" aria-hidden="true"><span>{guide.category.toUpperCase()}</span></div>
    <div class="container-geist relative z-10 py-6 sm:py-8 lg:py-10">
      <!-- Breadcrumb -->
      <nav class="font-mono text-xs text-mute dark:text-mute-dark" aria-label="Breadcrumb">
        <a href="/" class="hover:text-link dark:hover:text-link-dark">Home</a>
        <span class="mx-1.5">/</span>
        <a href={homeHref} class="hover:text-link dark:hover:text-link-dark">{country.short} guides</a>
        <span class="mx-1.5">/</span>
        <a href={topicHref} class="hover:text-link dark:hover:text-link-dark">{category?.name}</a>
        <span class="mx-1.5">/</span>
        <span class="text-body dark:text-body-dark">{guide.title}</span>
      </nav>

      <!-- Header -->
      <header class="mt-4">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <a
            href={topicHref}
            class="inline-flex items-center gap-1.5 rounded-md border border-hairline bg-canvas-elevated px-2.5 py-1 text-xs font-medium text-ink transition-colors hover:border-link hover:text-link dark:border-hairline-dark dark:bg-canvas-elevated-dark dark:text-ink-dark"
          >
            <Icon name={category?.icon ?? 'file'} class="size-3.5" /> {category?.name}
          </a>
          <span class="inline-flex items-center gap-1.5 rounded-md bg-link-soft px-2.5 py-1 text-xs font-medium text-link-deep dark:bg-link-soft-dark dark:text-link-dark">
            <CountryFlag code={guide.country} class="h-3.5 w-5" /> {country.name}
          </span>
          {guide.audience.map((a) => (
            <span class="rounded-md bg-hairline-soft px-2.5 py-1 font-mono text-xs text-body dark:bg-hairline-soft-dark dark:text-body-dark">{a}</span>
          ))}
        </div>

        <h1 class="heading-lg mt-3 max-w-3xl text-ink dark:text-ink-dark">{guide.title}</h1>

        <!-- Editorial metadata & verification -->
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 border-y border-hairline py-2.5 text-xs text-mute dark:border-hairline-dark dark:text-mute-dark">
          <div class="flex items-center gap-1.5">
            <Icon name="calendar" class="size-3.5 text-link" />
            <span>{editorial.lastReviewed ? <>Last reviewed: <strong class="font-medium text-ink dark:text-ink-dark">{editorial.lastReviewed}</strong></> : <>Updated <strong class="font-medium text-ink dark:text-ink-dark">{guide.updatedAt ?? '2026'}</strong></>}</span>
          </div>
          <span class="hidden sm:inline text-hairline-dark">|</span>
          <div class="flex items-center gap-1.5">
            <Icon name="check" class="size-3.5 text-emerald-600 dark:text-emerald-400" />
            <span>Verified against official <a href="/about/#standards" class="font-medium text-ink underline decoration-hairline hover:text-link dark:text-ink-dark">agency guidelines</a></span>
          </div>
        </div>

        {editorial.isOverdue && (
          <div class="mt-3 flex items-start gap-3 rounded-md border border-amber-300 bg-amber-50/80 p-3 text-xs text-amber-900 dark:border-amber-900/50 dark:bg-amber-950/40 dark:text-amber-200">
            <Icon name="alert" class="mt-0.5 size-4 shrink-0 text-amber-600 dark:text-amber-400" />
            <div>
              <strong class="font-semibold">Review in progress:</strong> This guide is past its scheduled review window. Our editorial team is currently auditing it against the latest government guidance. If you notice any recent agency rule changes, please <a href="/about#corrections" class="underline font-medium hover:text-amber-700 dark:hover:text-amber-100">report a correction</a>.
            </div>
          </div>
        )}

        <p class="mt-3 max-w-2xl text-base leading-relaxed text-body dark:text-body-dark" set:html={linkTerms(guide.summary)} />
          </div>
          <CategorySticker category={guide.category} class="hidden size-20 shrink-0 sm:block" />
        </div>

        <!-- Hero illustration -->
        <figure class="mt-4 max-w-3xl overflow-hidden rounded-lg border border-hairline bg-canvas-elevated shadow-sm dark:border-hairline-dark dark:bg-canvas-elevated-dark">
          <picture>
            <source srcset={heroImg.webpSrc} type="image/webp" />
            <img
              src={heroImg.src}
              alt={heroImg.alt}
              width={heroImg.width}
              height={heroImg.height}
              fetchpriority="high"
              decoding="async"
              class="h-auto w-full object-cover max-h-[380px]"
            />
          </picture>
        </figure>

        <!-- Share Buttons (top) -->
        <div class="mt-3 max-w-3xl">
          <ShareButtons title={guide.title} url={guideUrl} />
        </div>

        <div class="mt-2.5 max-w-3xl">
          <TranslateGuide />
        </div>
      </header>

      <!-- Quick facts -->
      <div class="mt-5 grid grid-cols-2 gap-2.5 sm:grid-cols-5">
        <InfoBox icon="gauge" label="Difficulty" value={guide.difficulty} />
        <InfoBox icon="timer" label="Total Time" value={guide.totalTime} />
        <InfoBox icon="dollar" label="Cost" value={guide.totalCost} />
        <InfoBox icon="list" label="Steps" value={`${guide.steps.length} steps`} />
        <InfoBox icon="calendar" label={editorial.lastReviewed ? 'Reviewed' : 'Updated'} value={editorial.lastReviewed ?? guide.updatedAt ?? '2026'} />
      </div>

      {/* Hero actions: official site + jump straight to the calculator (deep-linkable via #calculator) */}
      <div class="mt-4 flex flex-wrap gap-3">
        {officialLink && (
          <a
            href={officialLink.href}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-full bg-amber-400 px-5 py-2.5 text-sm font-semibold text-navy-900 shadow-sm transition hover:bg-amber-300"
          >
            Apply on the official site
            <Icon name="external" class="size-4" />
          </a>
        )}
        {guide.calculator && (
          <a
            href="#calculator"
            class="inline-flex items-center gap-2 rounded-full border border-link px-5 py-2.5 text-sm font-semibold text-link transition hover:bg-link hover:text-white dark:border-link-dark dark:text-link-dark dark:hover:bg-link-dark dark:hover:text-canvas-dark"
          >
            <Icon name="dollar" class="size-4" />
            Jump to calculator
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Content band: two-column doc layout — steps main column, sticky documents sidebar -->
  <div class="container-geist py-6 lg:py-8">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-8">
      <!-- Sidebar: documents first (gather before you start), sticky on desktop -->
      <aside class="lg:col-start-2 lg:row-start-1 lg:sticky lg:top-20 lg:self-start">
        <DocumentChecklist documents={guide.documents} />

        <!-- Disclaimer: warning treatment per Geist semantic colors -->
        <div class="mt-4 flex gap-3 rounded-md border border-amber-200/80 bg-amber-50/70 p-4 text-sm text-amber-950 dark:border-amber-900/40 dark:bg-amber-950/20 dark:text-amber-200">
          <Icon name="alert" class="mt-0.5 size-5 shrink-0 text-amber-600 dark:text-amber-400" />
          <p>
            <strong class="font-semibold text-amber-950 dark:text-amber-100">Before you act:</strong>
            Requirements, fees, and processing times change. Always confirm current details on the official government website
            ({country.sources}) before submitting anything.
          </p>
        </div>
      </aside>

      <!-- Main column: steps + FAQ + share + related -->
      <div class="min-w-0 lg:col-start-1 lg:row-start-1">
        <!-- Steps -->
        <section>
          <p class="eyebrow">The Steps</p>
          <h2 class="heading-md mt-1.5 text-ink dark:text-ink-dark">Follow these in order</h2>
          <p class="mt-2 text-sm text-body dark:text-body-dark">
            Each card shows the phase, expected time, and any cost. Data checked against official {country.short} sources
            {editorial.lastReviewed && (<span class="whitespace-nowrap font-mono text-[11px] font-medium text-link-deep dark:text-link-dark">({editorial.lastReviewed})</span>)}.
          </p>
          <div class="mt-4">
            <StepTimeline steps={guide.steps} category={guide.category} />
          </div>
        </section>

        <!-- Calculator (only on guides whose core task is a calculation) -->
        {guide.calculator && <Calculator id={guide.calculator} />}

        <!-- FAQ -->
        <section class="mt-8">
          <p class="eyebrow">FAQ</p>
          <h2 class="heading-md mt-1 text-ink dark:text-ink-dark">Frequently Asked Questions</h2>
          <div class="mt-3">
            <Faq faqs={guide.faqs} />
          </div>
        </section>

        <!-- Share Buttons (after FAQ) -->
        <div class="mt-6 rounded-md border border-hairline bg-canvas-elevated p-4 dark:border-hairline-dark dark:bg-canvas-elevated-dark">
          <p class="text-sm font-medium text-ink dark:text-ink-dark mb-2.5">Found this guide helpful? Share it with someone navigating this process:</p>
          <ShareButtons title={guide.title} url={guideUrl} />
        </div>

        <!-- Related guides (4-6 guides) -->
        {related.length > 0 && (
          <section class="mt-8">
            <div class="flex items-center justify-between">
              <div>
                <p class="eyebrow">Keep Reading</p>
                <h2 class="heading-md mt-1 text-ink dark:text-ink-dark">Related {country.short} Guides</h2>
              </div>
              <a href={homeHref} class="text-xs font-medium text-link hover:underline dark:text-link-dark">View all {country.short} guides &rarr;</a>
            </div>
            <div class="mt-3.5 grid gap-3 sm:grid-cols-2 md:grid-cols-3">
              {related.map((r) => (
                <a
                  href={guidePath(r)}
                  class="group flex flex-col justify-between rounded-lg border border-hairline bg-canvas-elevated p-4 text-sm font-medium text-ink transition-all hover:-translate-y-0.5 hover:border-link hover:text-link dark:border-hairline-dark dark:bg-canvas-elevated-dark dark:text-ink-dark dark:hover:border-link-dark dark:hover:text-link-dark"
                >
                  <div>
                    <div class="flex items-start justify-between gap-2">
                      <span class="line-clamp-2">{r.title}</span>
                      <Icon name="arrowright" class="mt-0.5 size-3.5 shrink-0 -translate-x-1 text-mute opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:text-link group-hover:opacity-100 dark:text-mute-dark dark:group-hover:text-link-dark" />
                    </div>
                  </div>
                  <div class="mt-3 flex items-center gap-2 pt-2 border-t border-hairline/60 text-xs font-normal text-mute dark:border-hairline-dark/60 dark:text-mute-dark">
                    <span class="inline-flex items-center gap-1">
                      <Icon name="gauge" class="size-3" /> {r.difficulty}
                    </span>
                    <span>&bull;</span>
                    <span class="inline-flex items-center gap-1">
                      <Icon name="timer" class="size-3" /> {r.totalTime}
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </div>

</Layout>
